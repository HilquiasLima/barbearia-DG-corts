# Copie este arquivo para .env somente quando for configurar notificacoes.
# NUNCA publique .env em repositorios nem compartilhe com clientes.
# As notificacoes nao sao enviadas automaticamente sem configuracao valida.

# E-mail: configure com o provedor SMTP da barbearia.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_TLS=1

# WhatsApp Business Cloud API (Meta): token, ID da linha e templates aprovados.
WA_ACCESS_TOKEN=
WA_PHONE_ID=
WA_TEMPLATE_BOOKED=
WA_TEMPLATE_CANCELLED=
WA_TEMPLATE_COMPLETED=
WA_LANGUAGE=pt_BR

# Em producao, HTTPS eh obrigatorio e COOKIE_SECURE deve ser 1.
COOKIE_SECURE=0
# SECRET_KEY=defina-uma-chave-aleatoria-longa-no-servidor

# Hospedagem (configurados automaticamente pelo render.yaml, menos SETUP_TOKEN)
# SETUP_TOKEN=escolha-uma-frase-longa-secreta-para-criar-o-dono
# DG_DB_PATH=/var/data/dgcortes.sqlite3
# DG_DATA_DIR=/var/data
# SECRET_KEY=uma-chave-longa-e-aleatoria
